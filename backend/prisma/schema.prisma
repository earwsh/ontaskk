generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CEO
  DEPARTMENT_MANAGER
  HR_MANAGER
  TECHNICAL_MANAGER
  STRATEGY_MANAGER
  EMPLOYEE
  CUSTOMER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_APPROVAL
  DONE
}

model UserDepartment {
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, departmentId])
}

model Department {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  managerId   Int?            @unique
  manager     User?           @relation("DepartmentManager", fields: [managerId], references: [id])
  members     UserDepartment[]
  projects    Project[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Project {
  id           Int             @id @default(autoincrement())
  name         String
  description  String?
  client       String?
  departmentId Int
  department   Department      @relation(fields: [departmentId], references: [id])
  createdById  Int
  createdBy    User            @relation("CreatedProjects", fields: [createdById], references: [id])
  tasks        Task[]
  members      ProjectMember[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  userId    Int
  user      User     @relation("ProjectMembers", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id             Int            @id @default(autoincrement())
  title          String
  description    String?
  status         TaskStatus     @default(TODO)
  startDate      DateTime?
  deadline       DateTime?
  estimatedHours Float?
  estimatedMinutes Int?
  weight           Int?
  approvedById   Int?
  approvedBy     User?          @relation("ApprovedTasks", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approverId     Int?
  approver       User?          @relation("TaskApprover", fields: [approverId], references: [id])
  projectId      Int
  project        Project        @relation(fields: [projectId], references: [id])
  createdById    Int
  createdBy      User           @relation("CreatedTasks", fields: [createdById], references: [id])
  assignees      TaskAssignee[]
  subtasks       TaskSubtask[]
  reports        TaskReport[]
  attachments    TaskAttachment[]
  notifications  Notification[]
  isRecurring         Boolean        @default(false)
  recurrencePattern   String?
  recurrenceDays      String?
  recurrenceEnd       DateTime?
  recurringParentId   Int?
  recurringParent     Task?          @relation("RecurringInstances", fields: [recurringParentId], references: [id], onDelete: SetNull)
  recurringInstances  Task[]         @relation("RecurringInstances")
  lastGeneratedDate   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model TaskAssignee {
  id          Int       @id @default(autoincrement())
  taskId      Int
  task        Task      @relation(fields: [taskId], references: [id])
  userId      Int
  user        User      @relation("TaskAssignees", fields: [userId], references: [id])
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([taskId, userId])
}

model TaskSubtask {
  id          Int       @id @default(autoincrement())
  title       String
  isDone      Boolean   @default(false)
  completedAt DateTime?
  taskId      Int
  task        Task      @relation(fields: [taskId], references: [id])
  createdAt   DateTime  @default(now())
}

model TaskReport {
  id        Int      @id @default(autoincrement())
  content   String
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id])
  userId    Int
  user      User     @relation("TaskReports", fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  message   String?
  read      Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  taskId    Int?
  task      Task?    @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  password     String
  firstName    String
  lastName     String
  displayName  String?
  birthDate    DateTime?
  startDate    DateTime?
  nationalId   String?     @unique
  position     String?
  role         Role        @default(EMPLOYEE)
  managedDept  Department? @relation("DepartmentManager")
  phone        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  projects     Project[]   @relation("CreatedProjects")
  taskAssignments TaskAssignee[] @relation("TaskAssignees")
  createdTasks    Task[]   @relation("CreatedTasks")
  projectMemberships ProjectMember[] @relation("ProjectMembers")
  taskReports  TaskReport[] @relation("TaskReports")
  approvedTasks  Task[]     @relation("ApprovedTasks")
  approverTasks  Task[]     @relation("TaskApprover")
  notifications  Notification[]
  departmentMemberships UserDepartment[]
  attachments    TaskAttachment[]
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  createdWebhooks  Webhook[]
}

model TaskAttachment {
  id        Int      @id @default(autoincrement())
  filename  String
  fileUrl   String
  mimeType  String?
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

enum ConversationType {
  DIRECT
  GROUP
  TASK
  DEPARTMENT
}

model Conversation {
  id           Int               @id @default(autoincrement())
  type         ConversationType  @default(DIRECT)
  title        String?
  taskId       Int?
  departmentId Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]
  messages     ChatMessage[]
}

model ChatParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachments    String?
  replyToId      Int?
  replyTo        ChatMessage? @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("ReplyTo")
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Webhook {
  id          Int      @id @default(autoincrement())
  name        String
  targetUrl   String
  secret      String?
  events      String
  isActive    Boolean  @default(true)
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


